# Hugging Face Token for Pyannote Speaker Diarization
# Replace the value below with your actual token
HF_TOKEN=xxxxxxxxxxxxxxxx


# --- Hardware Overrides (optional) ---
# Set to 'cuda' or 'cpu' to force a specific device. Leave empty for Auto-Detect.
DEVICE_OVERRIDE=

# --- Transcription Settings ---
# Options: tiny, base, small, medium, large-v2
MODEL_SIZE=base
WATCH_FOLDER=recordings

